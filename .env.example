# FinDash configuration. copy me to .env — .env is git-ignored.
# the Makefile includes .env, so `$(HOME)` expands like in a Makefile.
#
# `make run` and `make run-backend` forward these as server environment:
#   PORT       -> FINDASH_PORT
#   DATA_FILE  -> FINDASH_DATA

PORT=8080

# default to the tracked demo dataset so a fresh clone runs as-is;
# relative paths resolve from the repo root because make runs the app there.
# note: exporting from the app writes to this file, so put your real dataset
# anywhere outside the repo and point DATA_FILE at it, e.g. $(HOME)/your/folder/data.json
DATA_FILE=data.example.json
